{
  "name": "burka-exam",
  "version": "0.1.0",
  "private": true,
  "description": "Burka Exam entrance exam preparation platform",
  "type": "module",
  "workspaces": [
    "Backend",
    "Web"
  ],
  "scripts": {
    "dev": "node Backend/src/server.js",
    "build": "npm --workspace=Web run build",
    "start": "node Backend/src/server.js",
    "web:dev": "npm --workspace=Web run dev",
    "web:build": "npm --workspace=Web run build",
    "mobile:start": "npm --prefix Mobile start",
    "check": "npm --workspace=Backend run check",
    "lint": "npm run check",
    "test": "node --experimental-test-module-mocks --test Backend/src/config/jwt.test.js Backend/src/services/auth.service.test.js Backend/src/controllers/exam.submit.test.js Backend/src/controllers/notes.sync.test.js Web/JavaScript/src/utils/questionContentParser.test.js Web/JavaScript/src/utils/practiceStreamFilter.test.js Web/JavaScript/src/utils/examPracticeOrganizer.test.js Web/JavaScript/src/utils/offlineExamEngine.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "mongoose": "^8.19.1",
    "nodemailer": "^10.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^7.1.7"
  }
}
